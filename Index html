            <div class="bg-[#121a24] border border-gray-800 rounded-2xl p-6 w-full max-w-xs text-center shadow-2xl">
                <h3 class="text-lg font-semibold text-white mb-4">অ্যাডমিন প্রবেশাধিকার</h3>
                <p class="text-xs text-gray-400 mb-4">পাসওয়ার্ড প্রদান করুন</p>
                
                <input 
                    type="password" 
                    id="admin-password" 
                    placeholder="পাসওয়ার্ড লিখুন" 
                    class="w-full bg-[#1c2936] text-white placeholder-gray-500 text-sm px-4 py-3 rounded-xl border border-gray-700 focus:outline-none focus:border-[#39a374] mb-4 text-center"
