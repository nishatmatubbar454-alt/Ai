            <!-- Logo & Brand Name -->
            <div class="flex items-center space-x-2">
                <div class="w-7 h-7 bg-[#1b5e44] rounded-full flex items-center justify-center">
                    <span class="text-white text-xs font-bold">$</span>
                </div>
                <div class="flex items-center">
                    <span class="text-white font-bold text-lg">click2cash</span>
                    <span class="text-[#39a374] font-bold text-lg ml-1">AI</span>
                </div>
            </div>

            <!-- Top Right Chat Plus Icon -->
            <button id="clear-chat-btn" class="text-gray-300 hover:text-white transition duration-200 text-xl focus:outline-none" title="নতুন চ্যাট শুরু করুন">
                <i class="fa-regular fa-comment-dots"></i>
            </button>
        </header>

        <!-- CHAT AREA -->
        <main id="chat-box" class="flex-1 overflow-y-auto p-5 space-y-6 no-scrollbar pb-24 bg-[#0a0f16] flex flex-col justify-start">
            
            <!-- Welcome Header positioned near top with vibrant Red-Blue Gradient -->
            <div id="welcome-message" class="text-center pt-8 pb-12 flex flex-col items-center justify-start space-y-2">
                <h2 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-red-500 via-purple-500 to-blue-500 bg-clip-text text-transparent animate-pulse filter drop-shadow-[0_2px_8px_rgba(239,68,68,0.2)]">Welcome</h2>
                <p class="text-sm font-medium text-gray-400">How can I help you?</p>
            </div>

        </main>

        <!-- BOTTOM INPUT FORM -->
        <div class="absolute bottom-0 left-0 right-0 p-4 bg-[#0a0f16] border-t border-gray-900 bg-opacity-95 backdrop-blur-md">
            <form id="chat-form" class="relative flex items-center bg-[#151f2b] rounded-2xl border border-gray-800 px-4 py-3 shadow-lg">
                <input 
                    type="text" 
                    id="user-input" 
                    placeholder="Ask Binance Ai..." 
                    class="w-full bg-transparent text-gray-200 placeholder-gray-500 text-sm focus:outline-none pr-10"
                    autocomplete="off"
                    required
                >
                <!-- Send Action / Mic Icon -->
