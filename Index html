</head>
<body class="text-gray-100 flex justify-center items-center h-screen w-full p-0 sm:p-4 overflow-hidden">

    <!-- Main Container representing Mobile App Screen -->
    <div class="relative w-full h-full max-w-md bg-[#0a0f16] flex flex-col shadow-2xl border-0 sm:border border-gray-800 sm:rounded-3xl overflow-hidden">
        
        <!-- TOP NAVIGATION BAR -->
        <header class="flex items-center justify-between px-5 py-4 border-b border-gray-900 bg-[#0c131d]">
            <!-- Hamburger Menu (Triggers Sidebar/Menu with secret trigger) -->
            <button id="hamburger-btn" class="text-gray-300 hover:text-white transition duration-200 text-xl focus:outline-none">
                <i class="fa-solid fa-bars"></i>
