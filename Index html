                    <i class="fa-solid fa-microphone text-lg" id="mic-icon"></i>
                </button>
            </form>
        </div>

        <!-- HAMBURGER DRAWER MENU -->
        <div id="menu-drawer" class="hidden fixed inset-0 z-40 flex">
            <!-- Backdrop layer -->
            <div id="drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs"></div>
            <!-- Menu container -->
            <div class="relative flex flex-col w-64 max-w-xs bg-[#0c131d] border-r border-gray-900 h-full p-5 justify-between z-50">
                <div class="space-y-6">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest">মেনু</span>
                        <button id="close-drawer-btn" class="text-gray-400 hover:text-white transition">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    
                    <ul class="space-y-3">
                        <li>
                            <button onclick="startNewChat()" class="w-full text-left flex items-center space-x-3 text-gray-300 hover:text-white p-2.5 rounded-xl hover:bg-[#151f2b] transition">
                                <i class="fa-regular fa-comment text-sm text-gray-500"></i> 
                                <span class="text-sm">নতুন চ্যাট করুন</span>
                            </button>
                        </li>
                        <li>
                            <button onclick="showToast('শীঘ্রই আসছে!')" class="w-full text-left flex items-center space-x-3 text-gray-300 hover:text-white p-2.5 rounded-xl hover:bg-[#151f2b] transition">
                                <i class="fa-solid fa-info-circle text-sm text-gray-500"></i> 
                                <span class="text-sm">হেল্প সেন্টার</span>
                            </button>
                        </li>
                    </ul>
                </div>

